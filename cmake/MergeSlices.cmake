string(REPLACE "|" ";" stages "${STAGES}")
list(GET stages 0 first)

if(MODE STREQUAL "TREE")
  file(GLOB_RECURSE files RELATIVE "${first}/${SUBDIR}" "${first}/${SUBDIR}/*")
  foreach(stage IN LISTS stages)
    file(GLOB_RECURSE stage_files RELATIVE "${stage}/${SUBDIR}" "${stage}/${SUBDIR}/*")
    if(NOT stage_files STREQUAL files)
      message(FATAL_ERROR "${SUBDIR} has different files in ${first} and ${stage}")
    endif()
    if(stage STREQUAL first)
      continue()
    endif()
    foreach(file IN LISTS files)
      file(SHA256 "${first}/${SUBDIR}/${file}" first_hash)
      file(SHA256 "${stage}/${SUBDIR}/${file}" stage_hash)
      if(NOT first_hash STREQUAL stage_hash)
        message(FATAL_ERROR "${SUBDIR}/${file} differs between ${first} and ${stage}")
      endif()
    endforeach()
  endforeach()
  file(MAKE_DIRECTORY "${DEST}")
  file(COPY "${first}/${SUBDIR}/" DESTINATION "${DEST}")
  return()
endif()

if(NOT MODE STREQUAL "LIBS")
  message(FATAL_ERROR "MODE is LIBS or TREE, not ${MODE}")
endif()

file(MAKE_DIRECTORY "${DEST}")
file(GLOB entries LIST_DIRECTORIES false "${first}/${SUBDIR}/*")
foreach(entry IN LISTS entries)
  get_filename_component(name "${entry}" NAME)
  file(REMOVE "${DEST}/${name}")
  if(IS_SYMLINK "${entry}" OR NOT name MATCHES "\\.(a|dylib)$")
    file(COPY "${entry}" DESTINATION "${DEST}")
    continue()
  endif()
  set(slices)
  foreach(stage IN LISTS stages)
    list(APPEND slices "${stage}/${SUBDIR}/${name}")
  endforeach()
  execute_process(COMMAND "${LIPO}" -create ${slices} -output "${DEST}/${name}"
    RESULT_VARIABLE lipo_result)
  if(NOT lipo_result EQUAL 0)
    message(FATAL_ERROR "lipo failed for ${SUBDIR}/${name}")
  endif()
endforeach()
